KLINE_GAP_MAX_RATIO=0.001
KLINE_MAX_STALENESS_MINUTES=3
MARKET_DATA_MAX_STALENESS_MINUTES=5
PRICE_THRESHOLD_BPS=35
SMALL_MOVE_THRESHOLD_BPS=10
VOLUME_PERCENTILE_THRESHOLD=0.99
VOLUME_ROBUST_Z_THRESHOLD=4
OI_BUILDUP_THRESHOLD=2
PRICE_FLAT_NORM_THRESHOLD=0.5
REST_POLL_INTERVAL_SECONDS=60
INDICATOR_POLL_INTERVAL_SECONDS=5
WS_FLUSH_INTERVAL_SECONDS=0.2
KLINE_BACKFILL_LIMIT=180
DISCORD_CAPACITY=5
